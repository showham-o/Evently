VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Technical SEO
# Production domain (no trailing slash) - used for canonical URLs, Open
# Graph/Twitter tags, JSON-LD, robots.txt, and the sitemap generator.
# Leave unset in dev; set it in Vercel's env vars once a domain is chosen.
VITE_SITE_URL=https://your-domain.example

# Google Analytics 4 Measurement ID. Leave as the placeholder (or unset) to
# keep analytics disabled - the snippet in index.html checks for a real
# G-xxxxxxxxxx value before it ever loads gtag.js.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
